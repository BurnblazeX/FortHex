# === forthex.xyz origin — static host for the indev build ===
#
# Caddy binds LOCALHOST:8080 only. It does not terminate TLS and does not touch
# ports 80/443, because it is not reachable from the internet: the connection is
# Cloudflare Tunnel -> cloudflared -> here.
#
# WHY A TUNNEL AND NOT A PORT FORWARD. The router's WAN address is 10.35.91.250 —
# RFC1918 space handed out by the ISP over PPPoE. That is carrier-grade NAT: there
# is no public address on the router to forward a port from, so no amount of router
# configuration can expose this machine. An outbound tunnel is the only way in.
# (This is the same CGNAT case the roadmap names as B2's accepted P2P coverage gap.)
#
# Install:  sudo cp host/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# WHY TLS STILL MATTERS even though Caddy is not the one doing it. Cloudflare serves
# forthex.xyz over real https, and FortHex behaves differently in a secure context:
#   - crypto.randomUUID is secure-context only. js/client/profile.js carries a
#     getRandomValues fallback written specifically because the LAN host was plain
#     http (A5). Over the tunnel the standard path runs instead — first time it has.
#   - navigator.storage.persist(), which protects the profile and autosaves from
#     eviction, only works in a secure context.
#   - The service worker (sw.js) and PWA install only work over https.

:8080 {
	root * /srv/forthex
	encode zstd gzip
	file_server

	# Trust the tunnel's forwarded client address rather than logging cloudflared's
	# loopback address for every request.
	servers {
		trusted_proxies static 127.0.0.1/32 ::1
	}

	# dist/ui-bundle.js is rebuilt by `npm run build` and its name never changes, so a
	# stale cached copy would silently keep serving the old menu. Revalidate every
	# load; the file is ~150KB and this is a game, not a CDN-scale problem.
	@bundle path /dist/*
	header @bundle Cache-Control "no-cache"

	# Same reasoning, more so: the service worker decides what everything else caches.
	@sw path /sw.js
	header @sw Cache-Control "no-cache"

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=604800"

	# The game runs first-party. The two exceptions are declared rather than left
	# implicit: Tailwind's CDN script and Google Fonts, both loaded by index.html.
	# If Candidates F2 self-hosts the font pairing, the fonts.* entries come out.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' wss://forthex.xyz"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# Reserved for the Node game server. Commented out until host/game-server.js
	# exists — Caddy fails a reload if it proxies to nothing, and a broken reload
	# would take the static site down with it.
	# handle /ws* {
	# 	reverse_proxy localhost:8081
	# }
}
